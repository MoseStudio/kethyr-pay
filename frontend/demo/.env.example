# KethyrPay Demo — 前端环境变量示例
#
# 两种运行方式（Vite 优先级：`.env.[mode]` > `.env`）：
#   1) 本地开发 `pnpm dev`  → 读 `.env`            → 指向本地 validator（localnet）
#   2) 生产构建 `pnpm build` → 读 `.env.production` → 指向 devnet（即 CF 上线的版本）
#
# 复制本文件为 `.env` 并按需修改；`.env` / `.env.local` 均已被 gitignore。

# ── Aleo 侧（既有 checkout 流程）───────────────────────────────
VITE_USE_REAL_TRANSACTIONS=true
VITE_RPC_ENDPOINT=https://api.provable.com/v2/testnet
VITE_ENABLE_PERFORMANCE_PANEL=false

# ── Kethyr Flow（Solana 流式薪酬）──────────────────────────────
VITE_PAYROLL_PROGRAM_ID=Afm1YLnn7WBqbGgBvtxt8GMdV4LbogNqkhbtErXouP4v

# 本地方案（localnet）：validator + 本地 mint，见 scripts/localnet-fund.sh
VITE_SOLANA_CLUSTER=localnet
VITE_SOLANA_RPC=http://127.0.0.1:8899
# 由 `.localnet/mint.json` 创建（地址固定，跨 --reset 稳定）
VITE_PAYROLL_MINT=6xPgjRpt3LS3vtxQjJPitNMELtd3sDrCiLHqUqhsbsrm

# devnet 方案（路演/远程评测）：见 frontend/demo/.env.production 与 scripts/devnet-setup.sh
# VITE_SOLANA_CLUSTER=devnet
# VITE_SOLANA_RPC=https://api.devnet.solana.com
# VITE_PAYROLL_MINT=FZajpoDvjLbpdeK2CvcdGmg1wGqcWrVYqvYC2thFcp8m
