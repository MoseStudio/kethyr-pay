{
  "name": "kethyrpay-demo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "predev": "pnpm --dir ../../packages/sdk build",
    "dev": "vite dev --port 3002",
