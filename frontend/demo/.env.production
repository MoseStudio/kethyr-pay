# 生产（devnet）配置 —— 由 `vite build` 自动加载。
#
# 注意：Vite 的优先级是 `.env.[mode]` > `.env`，所以：
#   - `pnpm build`（production 模式）→ 用本文件的 devnet 配置（也就是 CF 上线的版本）
#   - `pnpm dev`  （development 模式）→ 用本地 `.env` 的 localnet 配置
# 这样本地联调不必改来改去，线上又永远指向 devnet。
#
# 这里没有密钥，只有公开地址，因此提交进仓库是安全的。

# Aleo 侧（既有 checkout 流程）
VITE_USE_REAL_TRANSACTIONS=true
VITE_RPC_ENDPOINT=https://api.provable.com/v2/testnet
VITE_ENABLE_PERFORMANCE_PANEL=false

# Kethyr Flow（Solana 流式薪酬）—— devnet
VITE_PAYROLL_PROGRAM_ID=Afm1YLnn7WBqbGgBvtxt8GMdV4LbogNqkhbtErXouP4v
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC=https://api.devnet.solana.com
# 由 scripts/devnet-setup.sh 用 `.devnet/mint.json` 创建（地址固定）
VITE_PAYROLL_MINT=FZajpoDvjLbpdeK2CvcdGmg1wGqcWrVYqvYC2thFcp8m
