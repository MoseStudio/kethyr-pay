{
  "name": "@kethyrpay/sdk",
  "version": "0.1.0",
  "description": "KethyrPay 最小 SDK：Aleo 支付封装（WASM 初始化、钱包适配器、KethyrPay 主类），基于 @provablehq/sdk 与 @provablehq/aleo-wallet-adaptor-*",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "aleo",
    "kethyrpay",
    "zero-knowledge",
    "payment",
    "sdk",
    "wasm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@provablehq/aleo-types": "^1.0.1",
    "@provablehq/aleo-wallet-adaptor-core": "^1.0.1",
    "@provablehq/aleo-wallet-adaptor-shield": "^1.0.1",
    "@provablehq/sdk": "^0.11.6"
  },
  "peerDependenciesMeta": {
    "@provablehq/aleo-wallet-adaptor-shield": {
      "optional": true
    }
  },
  "devDependencies": {
    "@provablehq/aleo-types": "^1.0.1",
    "@provablehq/aleo-wallet-adaptor-core": "^1.0.1",
    "@provablehq/aleo-wallet-adaptor-shield": "^1.0.1",
    "@provablehq/sdk": "^0.11.6",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  }
}
